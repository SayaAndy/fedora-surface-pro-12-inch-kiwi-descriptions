#!/bin/bash
set -eu
umask 022

COMMAND="$1"
KVER="$2"

SRC="/etc/surface-dtb/x1p42100-microsoft-surface-pro-12-inch.dtb"
DEST="/usr/lib/modules/${KVER}/dtb/qcom/x1p42100-microsoft-surface-pro-12-inch.dtb"

case "${COMMAND}" in
	add)
		mkdir -p "$(dirname ${DEST})"
		cp -f "${SRC}" "${DEST}"
		chmod 644 "${DEST}"
		;;
	remove)
		rm -f "${DEST}"
		;;
esac
